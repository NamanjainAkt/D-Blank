# ========================================
# D-Blanks Environment Variables
# ========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ===============================
# DATABASE (Required)
# ===============================
# Get from MongoDB Atlas - click "Connect" → "Connect your application"
# Free M0 tier: https://www.mongodb.com/atlas/database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dblanks?retryWrites=true&w=majority

# ===============================
# AUTH (Required)
# ===============================
# Generate a random 32+ character string at https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=your-super-secret-key-here-minimum-32-characters
# IMPORTANT: Update to production URL when deploying
NEXTAUTH_URL=http://localhost:3000

# ===============================
# PHONEPE (Required for payments)
# ===============================
# Register at https://business.phonepe.com - takes 3-7 days for approval
# Use sandbox credentials for testing, production credentials for live
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1

# ===============================
# EMAIL (Optional - Resend)
# ===============================
# Get free API key at https://resend.com - 3000 emails/month free
# For development, use the domain verification or test with your own email
RESEND_API_KEY=re_your_api_key_here

# ===============================
# CLOUDINARY (Optional - Image uploads)
# ===============================
# Get free account at https://cloudinary.com - 25GB storage free
# Find credentials in Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===============================
# ADMIN (Required for seeding)
# ===============================
# These are used by the seed script to create the first admin account
ADMIN_EMAIL=admin@dblanks.in
ADMIN_PASSWORD=admin123

# ===============================
# SITE URL (Required for production)
# ===============================
# Set this to your production domain when deploying
# Used by: sitemap, robots.txt, OG images, canonical URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# For production, set: NEXT_PUBLIC_BASE_URL=https://dblanks.site

# ===============================
# NOTES
# ===============================
# 1. After setting up MongoDB, run: npm run seed
# 2. After setting up PhonePe, test payments in sandbox mode first
# 3. For production, update NEXTAUTH_URL to your domain
# 4. All external services have generous free tiers
